# Documentation only: settings read environment variables, not this file automatically.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
GUARDIAN_DETECTOR=ai.adapters.UnconfiguredDetector
# GUARDIAN_DETECTOR=ai.adapters.TeamDetector
# GUARDIAN_CAMERA_SOURCE=0
# SMTP is optional; no external email is sent with the default console backend.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# Pose runtime for the live server: auto (times DirectML / OpenVINO once and keeps the lightest) | directml | openvino | torch
# GUARDIAN_POSE_BACKEND=auto
# GUARDIAN_POSE_DEVICE=1          # DirectML adapter index, or an OpenVINO device such as GPU.0 / CPU
# Share of time the model may be busy when cameras are live (lower = lighter on the laptop, fewer frames per camera).
# GUARDIAN_AI_DUTY=0.65

# --- Database: SQLite by default; PostgreSQL when these are set (see README "Database") ---
# GUARDIAN_DB=postgres
# GUARDIAN_DB_NAME=guardianai
# GUARDIAN_DB_USER=guardian
# GUARDIAN_DB_PASSWORD=
# GUARDIAN_DB_HOST=127.0.0.1
# GUARDIAN_DB_PORT=5432
# GUARDIAN_PG_HOME=C:\path\to\folder-with-pgsql-and-data

# --- Accounts -----------------------------------------------------------------
# 1 = self-registered accounts stay inactive until an Administrator activates them (default 0: active as Caregiver).
# GUARDIAN_REGISTRATION_APPROVAL=0
# Password-reset codes are e-mailed. With the default console backend the code is printed in the server window.
# Real e-mail through Gmail: turn on 2-step verification, create an "App password", then:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=yourproject@gmail.com
# EMAIL_HOST_PASSWORD=<16-character app password>
# DEFAULT_FROM_EMAIL=GuardianAI <yourproject@gmail.com>
