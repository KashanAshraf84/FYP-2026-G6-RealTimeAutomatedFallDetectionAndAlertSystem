# Raw dataset videos (1 GB, third-party licence) - download GMDCSA-24 separately; the pose cache in data/keypoints is kept
data/dataset/**/*.mp4
data/dataset/**/*.avi
data/*.db
data/*.npz

# Local runtime output (alert snapshots contain people's images)
logs/
training/logs/
training/results/quick/
deploy/build/
